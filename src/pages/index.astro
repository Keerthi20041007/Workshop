---
// The catalog renders all build-time data once, then uses a scoped script for accessible client-side filtering.
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form
            class="mb-8 grid gap-6 rounded-xl border border-slate-700 bg-slate-800/60 p-6 md:grid-cols-[2fr_1fr_auto]"
            data-testid="game-filters"
          >
            <fieldset>
              <legend class="mb-3 text-sm font-semibold text-slate-100">Filter by category</legend>
              <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                  <label class="flex items-center gap-2 text-sm text-slate-300">
                    <input
                      type="checkbox"
                      value={category.id}
                      data-category-filter={category.id}
                      data-testid={`category-filter-${category.id}`}
                      class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                    />
                    <span>{category.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <label class="text-sm font-semibold text-slate-100" for="publisher-filter">
              <span class="mb-3 block">Filter by publisher</span>
              <select
                id="publisher-filter"
                data-testid="publisher-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 font-normal text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
              </select>
            </label>

            <button
              type="reset"
              data-testid="clear-filters"
              class="self-end rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              Clear filters
            </button>
          </form>

          <div
            class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
            data-testid="games-grid"
          >
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div class="hidden" data-testid="filter-empty-state" aria-live="polite">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');

  if (filterForm && gamesGrid && emptyState) {
    const updateResults = (): void => {
      const selectedCategories = Array.from(
        filterForm.querySelectorAll<HTMLInputElement>('[data-category-filter]:checked'),
      ).map((input) => input.value);
      const selectedPublisher = filterForm.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]')?.value ?? '';

      let visibleCount = 0;
      for (const card of gameCards) {
        const categoryMatches =
          selectedCategories.length === 0 || selectedCategories.includes(card.dataset.categoryId ?? '');
        const publisherMatches =
          selectedPublisher === '' || card.dataset.publisherId === selectedPublisher;
        const visible = categoryMatches && publisherMatches;
        card.classList.toggle('hidden', !visible);
        visibleCount += visible ? 1 : 0;
      }

      gamesGrid.classList.toggle('hidden', visibleCount === 0);
      emptyState.classList.toggle('hidden', visibleCount > 0);
    };

    filterForm.addEventListener('change', updateResults);
    filterForm.addEventListener('reset', () => requestAnimationFrame(updateResults));
  }
</script>
